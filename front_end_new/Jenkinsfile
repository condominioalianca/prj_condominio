// ============================================================
// Jenkinsfile — Pipeline do Frontend (React + Vite + Nginx)
// Repositório: c:\GIT\prj_condominio
// Trigger: Manual
// ============================================================
pipeline {
    agent any

    environment {
        // URL do Backend (injetada no build do Vite como variável de ambiente)
        BACK_END_NOVA_ALIANCA = credentials('COND_BACK_END_URL')

        // Docker
        DOCKER_IMAGE   = 'patrickmoura/novaalianca-front'
        CONTAINER_NAME = 'frontnovaalianca'
        APP_PORT       = '3001'
    }

    stages {

        stage('🔍 Checkout') {
            steps {
                echo '=== Clonando repositório ==='
                checkout scm
            }
        }

        stage('📦 Build Vite') {
            steps {
                echo '=== Instalando dependências e compilando o Frontend ==='
                dir('front_end_new') {
                    sh '''
                        npm ci --prefer-offline
                        npm run build
                    '''
                }
            }
        }

        stage('🐳 Docker Build') {
            steps {
                echo '=== Construindo imagem Docker do Frontend ==='
                dir('front_end_new') {
                    sh '''
                        docker build \
                            --build-arg BACK_END_NOVA_ALIANCA="${BACK_END_NOVA_ALIANCA}" \
                            -t ${DOCKER_IMAGE}:latest \
                            -t ${DOCKER_IMAGE}:${BUILD_NUMBER} \
                            .
                    '''
                }
            }
        }

        stage('🚀 Deploy') {
            steps {
                echo '=== Parando container antigo e subindo novo ==='
                sh '''
                    # Para e remove o container anterior (se existir)
                    docker stop ${CONTAINER_NAME} || true
                    docker rm   ${CONTAINER_NAME} || true

                    # Sobe o novo container do Frontend (Nginx na porta 3001)
                    docker run \
                        --name ${CONTAINER_NAME} \
                        --restart=always \
                        -d \
                        -p ${APP_PORT}:80 \
                        ${DOCKER_IMAGE}:latest
                '''
            }
        }

        stage('✅ Health Check') {
            steps {
                echo '=== Verificando se o Frontend está respondendo ==='
                sh '''
                    sleep 5
                    curl -f http://localhost:${APP_PORT} || \
                        (echo "ERRO: Frontend não respondeu!" && exit 1)
                '''
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline do Frontend concluída com sucesso! Build #${BUILD_NUMBER}"
        }
        failure {
            echo "❌ Pipeline do Frontend FALHOU no build #${BUILD_NUMBER}. Verifique os logs acima."
        }
        always {
            sh 'docker image prune -f || true'
        }
    }
}
